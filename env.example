# Settings read at run time. Copy to .env and fill in what applies to your setup.
# On EIDF, `. setup/eidf/session.sh` exports everything in .env.

# ---- models --------------------------------------------------------------------------------
# Optional: a folder of models laid out as <store>/<Hugging Face id> (e.g. <store>/Qwen/Qwen3-4B).
# When a model is there, exp loads it from the store instead of downloading it.
SHARED_MODEL_STORE=
# Optional: training metrics to wandb. Without it, exp grpo logs to the console, and
# exp sft --wandb-run needs it.
WANDB_API_KEY=

# ---- sandboxes -----------------------------------------------------------------------------
# URL that agents running INSIDE a sandbox use to reach the model server. Default for the
# docker backend: host.docker.internal (Docker Desktop) or the bridge gateway (Linux).
# Required for every other backend, e.g. http://<server pod IP>:8000/v1 on EIDF.
SANDBOX_API_BASE=
# Prebuilt Reasoning Gym task image, for backends with no build step (eidf). `exp tasks -b
# reasoning_gym` writes it into every task.toml. Build and push it with
# benchmarks/reasoning_gym/tasks/build_task_image.sh. Unset: task.toml is left as fetched and the
# docker backend builds each task's environment/Dockerfile instead.
RG_TASK_IMAGE=
# The AppWorld task image (AppWorld with its data baked in), required by `exp tasks -b appworld`,
# which names it in every task.toml. Build and push it to a registry of your own with
# benchmarks/appworld/tasks/build_appworld_image.sh <image>.
APPWORLD_IMAGE=

# ---- the eidf sandbox backend (Kubernetes; --backend eidf) ---------------------------------
PROJECT_ROOT=         # the project folder on the shared filesystem; session.sh looks for kube/kubeconfig and kubectl there.
                      # (Also the placeholder in benchmarks/bfcl_multiturn/tasks/gen_mt_tasks*.py, which exp tasks rewrites.)
K8S_NAMESPACE=        # the namespace sandboxes run in
KUEUE_QUEUE=          # the Kueue queue that admits them
EIDF_USER=            # the user id sandbox pods run as
EIDF_GROUPS=          # their groups (space-separated)
EIDF_HOME=            # their home folder
KUBECONFIG=           # kubectl's config; session.sh defaults it to $PROJECT_ROOT/kube/kubeconfig when unset

# ---- building images without Docker (setup/eidf/kaniko_build.sh) ---------------------------
KANIKO_DOCKER_SECRET= # a docker-registry secret in the namespace with push access
KANIKO_PVC=           # the PersistentVolumeClaim of the shared filesystem
KANIKO_PVC_MOUNT=     # where pods mount it (default /ceph_big)
KANIKO_IMAGE=         # optional: the kaniko executor image
