      "url": "http://localhost:8080/fhir/Observation?patient=S3032536&code=MG&_sort=-date&_format=json",
      "expect_url": "http://localhost:8080/fhir/Observation?patient=S3032536&code=MG&_format=json",
      "expect_synthetic": false
    },
    {
      "id": "sort-ignored-param-last",
      "arm": {"sort_support": "ignored"},
      "url": "http://localhost:8080/fhir/Observation?code=MG&_sort=-date",
      "expect_url": "http://localhost:8080/fhir/Observation?code=MG",
      "expect_synthetic": false
    },
    {
      "id": "count-injected",
      "arm": {"bundle_count": 10},
      "url": "http://localhost:8080/fhir/Observation?patient=S3032536&code=MG",
      "expect_url": "http://localhost:8080/fhir/Observation?patient=S3032536&code=MG&_count=10",
      "expect_synthetic": false
    },
    {
      "id": "count-not-doubled",
      "arm": {"bundle_count": 10},
      "url": "http://localhost:8080/fhir/Observation?code=MG&_count=50",
      "expect_url": "http://localhost:8080/fhir/Observation?code=MG&_count=50",
      "expect_synthetic": false
    },
    {
      "id": "qualified-bare-code-goes-empty",
      "arm": {"code_system_form": "qualified"},
      "url": "http://localhost:8080/fhir/Observation?patient=S3032536&code=MG&_format=json",
      "expect_url": "http://localhost:8080/fhir/Observation?patient=S3032536&code=MG&_format=json",
      "expect_synthetic": true
    },
    {
      "id": "qualified-piped-code-translated-to-bare",
      "arm": {"code_system_form": "qualified"},
      "url": "http://localhost:8080/fhir/Observation?code=http://loinc.org|MG&_format=json",
      "expect_url": "http://localhost:8080/fhir/Observation?code=MG&_format=json",
      "expect_synthetic": false
    },
    {
      "id": "qualified-urlencoded-pipe-translated",
      "arm": {"code_system_form": "qualified"},
      "url": "http://localhost:8080/fhir/Observation?code=http%3A%2F%2Floinc.org%7CMG",
      "expect_url": "http://localhost:8080/fhir/Observation?code=MG",
      "expect_synthetic": false
    },
    {
      "id": "qualified-no-code-param-untouched",
      "arm": {"code_system_form": "qualified"},
      "url": "http://localhost:8080/fhir/Patient?name=Peter&_format=json",
      "expect_url": "http://localhost:8080/fhir/Patient?name=Peter&_format=json",
      "expect_synthetic": false
    }
  ],
  "response_cases": [
