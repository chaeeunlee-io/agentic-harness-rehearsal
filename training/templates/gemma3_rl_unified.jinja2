{#- Gemma-3 chat template, UNIFIED for multi-harness RL (2026-09-19).
    GRPO serves ONE model for parity + t2 + fc rollouts simultaneously, so a
    single template must satisfy all three. This file is the union of the two
    existing Gemma templates:
      * from gemma3_merge_tolerant.jinja2: consecutive same-role messages are
        MERGED instead of raising, which t2's summarization/handoff flow
        requires (stock template hard-raises -> 400 -> episode death, biased by
        treatment; see docs/eidf/gemma-t2-alternation-incident.md).
      * from gemma3_hermes_fc.jinja2: assistant `tool_calls` render as
        <tool_call>{...}</tool_call> for the hermes parser, with the
        str-vs-dict argument coercion (training rows carry JSON strings, live
        multi-turn requests echo parsed dicts; mixing them crashed every
        multi-turn fc render before 2026-09-15).
    role="tool" folds into a user turn wrapped in <tool_response> tags.
    Validated at build time: byte-identical to Gemma's stock template on
    conforming (alternating, tool-call-free) conversations, and identical to
    the hermes template on tool-call conversations. -#}
{{ bos_token }}
{%- if messages[0]['role'] == 'system' -%}
    {%- if messages[0]['content'] is string -%}
        {%- set first_user_prefix = messages[0]['content'] + '

' -%}
    {%- else -%}
        {%- set first_user_prefix = messages[0]['content'][0]['text'] + '

' -%}
    {%- endif -%}
    {%- set loop_messages = messages[1:] -%}
{%- else -%}
    {%- set first_user_prefix = "" -%}
    {%- set loop_messages = messages -%}
{%- endif -%}
{%- set ns = namespace(prev='') -%}
{%- for message in loop_messages -%}
    {%- set eff = 'model' if message['role'] == 'assistant' else 'user' -%}
    {%- if message['content'] is string -%}
        {%- set body = message['content'] | trim -%}
    {%- elif message['content'] is none or message['content'] is not defined -%}
        {%- set body = '' -%}
    {%- elif message['content'] is iterable -%}
        {%- set parts = namespace(t='') -%}
        {%- for item in message['content'] -%}
            {%- if item['type'] == 'image' -%}
                {%- set parts.t = parts.t + '<start_of_image>' -%}
            {%- elif item['type'] == 'text' -%}
                {%- set parts.t = parts.t + (item['text'] | trim) -%}
            {%- endif -%}
        {%- endfor -%}
        {%- set body = parts.t -%}
    {%- else -%}
        {{ raise_exception("Invalid content type") }}
    {%- endif -%}
    {%- if message['role'] == 'tool' -%}
        {%- set body = '<tool_response>
' + body + '
</tool_response>' -%}
    {%- endif -%}
    {%- if message['role'] == 'assistant' and message['tool_calls'] is defined and message['tool_calls'] -%}
        {%- set tcns = namespace(s='') -%}
        {%- for tc in message['tool_calls'] -%}
            {%- set tc_args = tc['function']['arguments'] if tc['function']['arguments'] is string else tc['function']['arguments'] | tojson -%}
            {%- set tcns.s = tcns.s + '
<tool_call>
{"name": "' + tc['function']['name'] + '", "arguments": ' + tc_args + '}
</tool_call>' -%}
        {%- endfor -%}
        {%- set body = body + tcns.s -%}
    {%- endif -%}
    {%- if eff != ns.prev -%}
        {%- if not loop.first -%}
            {{ '<end_of_turn>
' }}
        {%- endif -%}
        {{ '<start_of_turn>' + eff + '
' + (first_user_prefix if loop.first else "") }}
    {%- else -%}
        {{ '

' }}
    {%- endif -%}
    {{ body }}
    {%- set ns.prev = eff -%}
{%- endfor -%}
{%- if loop_messages -%}
    {{ '<end_of_turn>
' }}
{%- endif -%}
{%- if add_generation_prompt -%}
    {{'<start_of_turn>model
'}}
{%- endif -%}
